# 地图源注册表（运行时数据：首启由 ROBOT_IP/MAPS_IO 等环境变量种入，含主机与路径）
LLM/data/maps_sources.json

# ⚠️ 生物特征运行时数据**绝不入库**（隐私红线）：
#   LLM/data/faces/<uid>/     人脸照片 + ArcFace 指纹（指纹可用于比对，等同凭证）
#   LLM/data/speakers/<uid>.npz  声纹样本
LLM/data/faces/
LLM/data/speakers/
# 数据库备份（删档案等破坏性操作前由 scripts/update_elder.py 自动落一份，不入库）
LLM/data/backup/

# 子代理驱动开发的临时工作产物（进度账本/简报/审查包，不入库）
.superpowers/
/.worktrees/
# 开发期临时探针/一次性脚本（含跑测试留下的日志；不是产品代码，从不入库）
.ptmp_shim/

# ROS2 工作区构建产物（不入库，板卡上保留即可）
ros2_car/build/
ros2_car/install/
ros2_car/log/

# 板卡 ROS 现场诊断一次性脚本（不入库）
.diag/

# 外部教程项目（自带独立 .git 的嵌套仓库，不入库）
/localization-with-ROS/
/linorobot2/
# 外部开源工程：第三期地图编辑器像素修图的改造上游（GyroPalm/ROS-SLAM-Map-Editor，MIT）
/ROS-SLAM-Map-Editor/

# Python
ros2_car/**/__pycache__/
ros2_car/**/*.py[cod]

# SLAM 地图产物（运行时生成，用 map_saver_cli 保存，不入库）
ros2_car/src/robot_bringup/maps/*.pgm
ros2_car/src/robot_bringup/maps/*.yaml

# 地图编辑器保存前自动备份（/mapeditor/pixel-editor.html 每次写盘前落一份，不入库）
ros2_car/maps/.backup/

# pnpm 本地 store（离线安装时会落在仓库内，勿入库）
.pnpm-store/

# 语音：运行时模型与调研残留不入库
LLM/models/
# 视觉：人脸检测等 ONNX 权重（运行时下载，python -m vision.face --download，不入库）
vision/models/
# 视觉：人脸检测/识别的固定测试图（约 3.5MB 二进制，不入库；来源与重取见 vision/testdata/README.md）
vision/testdata/*.jpg
vision/testdata/*.png
# 摄像头/人脸测试落的图（含 vision.face --out 的画框产物）：任何扩展名都不入库
vision/testdata/*.jpeg
vision/testdata/*.bmp
vision/testdata/*.webp
vision/testdata/*.gif
/det_*.jpg
/det_*.png
/*.jpg
/*.jpeg
/*.png
